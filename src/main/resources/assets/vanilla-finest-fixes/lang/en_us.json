  "vanilla-finest-fixes.macos_input_fixes.trackpad_sensitivity": "Trackpad Sensitivity",
  "vanilla-finest-fixes.macos_input_fixes.trackpad_sensitivity.tip": "The grouping feature only affects hotbar scrolling.\nThis feature only affects scrolling from the trackpad (and other high precision devices).\nDefault: 20.0\n0.0: Disable custom trackpad scroll processing.\nOther: group scrolls together to make scrolling speed much more reasonable on hotbar, scroll amount is divided by the value chosen here.",
  "vanilla-finest-fixes.macos_input_fixes.momentum_scrolling": "Momentum Scrolling",
  "vanilla-finest-fixes.macos_input_fixes.momentum_scrolling.tip": "Only affects hotbar scrolling.\nA momentum scroll is when macOS keeps scrolling after you release the wheel.\nDefault: OFF\nOFF: ignore 'momentum scroll' events.\nON: process 'momentum scroll' events.",
  "vanilla-finest-fixes.macos_input_fixes.smooth_scroll": "Interface Smooth Scroll",
  "vanilla-finest-fixes.macos_input_fixes.smooth_scroll.tip": "Affects all scrolling from legacy input devices (except for the hotbar).\nmacOS sometimes adjusts how much a single scroll does to make it feel 'smoother', but this can cause scroll amounts to feel random sometimes.\nDefault: OFF\nOFF: Modify smooth scrolling events to all be the same scroll amount.\nON: Keep smooth scrolling events as-is.",
  "vanilla-finest-fixes.macos_input_fixes.disable_ctrl_click_fix": "Disable Ctrl+Click Fix",
  "vanilla-finest-fixes.macos_input_fixes.disable_ctrl_click_fix.tip": "When enabled, disables the fix for the bug which causes Minecraft\nto map Control + Left Click to Right Click.\nDefault: OFF",
  "vanilla-finest-fixes.macos_input_fixes.use_p3_color_space": "Use P3 Color Space",
  "vanilla-finest-fixes.macos_input_fixes.use_p3_color_space.tip": "When enabled, uses the P3 color space for rendering instead of sRGB.\nThis reverts the fix made in Minecraft 26.2+\nwith the new Vulkan renderer, that causes colors to be less vibrant.\nRequires game restart to take effect.\nDefault: OFF",
  "vanilla-finest-fixes.macos_input_fixes.reverse_hotbar_scrolling": "Reverse Hotbar Scroll",
  "vanilla-finest-fixes.macos_input_fixes.reverse_hotbar_scrolling.tip": "Reverses the direction that scrolling goes for the hotbar when enabled.\nDefault: OFF",
  "vanilla-finest-fixes.macos_input_fixes.lock_scroll_while_attacking": "Lock Scroll While Attacking/Using",
  "vanilla-finest-fixes.macos_input_fixes.lock_scroll_while_attacking.tip": "Ignores scrolling while the attack key is held down and you are in game (no screen open).\nUseful on a Magic Mouse or trackpad, where a small finger movement while mining\ncauses an accidental scroll that switches the selected hotbar item.\nDefault: OFF\nOFF: scrolling always works.\nON: scrolling is ignored while the attack key is held down.",
  "vanilla-finest-fixes.macos_input_fixes.reverse_scrolling": "Reverse Scrolling",
  "vanilla-finest-fixes.macos_input_fixes.reverse_scrolling.tip": "Reverses the direction of all scrolling when enabled.\nDefault: OFF",
  "vanilla-finest-fixes.macos_input_fixes-values.on": "ON",
  "vanilla-finest-fixes.macos_input_fixes-values.off": "OFF"
