        "Sets the Happy Ghast speed while descending vertically (Left Ctrl by default).": "descend_speed.desc",
        "Strafe Speed": "strafe_speed",
        "Sets the Happy Ghast speed while moving sideways (A and D by default).": "strafe_speed.desc",
        "Automatic Pitch: ON": "automatic_pitch.on",
        "Automatic Pitch: OFF": "automatic_pitch.off",
        "Adjusts the Happy Ghast vertical position while moving forward based on whether the player is looking up or down.": "automatic_pitch.desc",
        "Fixed Rotation: ON": "fixed_rotation.on",
        "Fixed Rotation: OFF": "fixed_rotation.off",
        "Fixes the Happy Ghast rotation to center around the player rider, allowing more precision while stationary and looking around.": "fixed_rotation.desc",
        "Smooth Glide: ON": "smooth_glide.on",
        "Smooth Glide: OFF": "smooth_glide.off",
        "Sets whether movements are smooth or instant while riding Happy Ghasts. Turn OFF for more precise movement.": "smooth_glide.desc",
        "Descend: Sneak": "descend.sneak",
        "Descend: Custom Keybind": "descend.custom",
        "Select whether to use the Sneak/Crouch key to Descend while riding a Happy Ghast, or to only use the custom Descend keybind. If using Double-Tap to Dismount, this should use Custom Keybind only.": "descend.desc",
        "Speed Boost": "speed_boost",
        "Apply a speed boost multiplier when pressing the Sprint key while riding Happy Ghasts. Double-tapping forward also boosts based on the global Minecraft setting. Resulting speed must be within the server maxiumum.": "speed_boost.desc",
        "Dismount: Custom Keybind": "dismount.custom",
        "Dismount: Sneak": "dismount.sneak",
        "Dismount: Double-Tap Sneak": "dismount.double_tap",
        "Select whether to require double tapping the Sneak/Crouch key to dismount while riding Happy Ghasts, or to apply the standard single tap Sneak/Crouch to dismount behaviour.": "dismount.desc",
        "Double-Tap Dismount Time": "double_tap_time",
        "Time window in ticks where double-tapping the Sneak/Crouch key dismounts the Happy Ghast. Only applies when Dismount is set to Double-Tap.": "double_tap_time.desc",
        "Server Settings": "server_settings",
        "Disable Roaming: ON": "disable_roaming.on",
        "Disable Roaming: OFF": "disable_roaming.off",
        "Makes all Happy Ghasts stop roaming while not being ridden. Only applies when wearing a Harness.": "disable_roaming.desc",
        "Disable Ambient Sound: ON": "disable_ambient_sound.on",
        "Disable Ambient Sound: OFF": "disable_ambient_sound.off",
        "Turn ON to silence all Happy Ghast ambient sounds (does not affect hurt/death sounds). Turn OFF to maintain all original sounds.": "disable_ambient_sound.desc",
        "Disable Mining Penalty: ON": "disable_mining_penalty.on",
        "Disable Mining Penalty: OFF": "disable_mining_penalty.off",
        "Turn ON to allow players to destroy blocks at normal speed while riding a Happy Ghast. Turn OFF to keep the default 5x slowness applied for not being on ground.": "disable_mining_penalty.desc",
        "Reach": "reach",
        "Sets the distance players can reach blocks and entities while riding a Happy Ghast. Normal reach is 4.5 blocks.": "reach.desc",
        "Ghast Size": "ghast_size",
        "Set the size of all Happy Ghasts to be smaller (or bigger). Normal size is 1.0.": "ghast_size.desc",
        "Default Speed": "default_speed",
        "Sets the default speed while riding Happy Ghasts. This also applies the default speed for anyone not using the client-side mod. Normal speed is 1.0.": "default_speed.desc",
        "Minimum Speed": "minimum_speed",
        "Sets the minimum client speed settings allowed while riding Happy Ghasts. Normal speed is 1.0. Overrides any client config that exeeds this.": "minimum_speed.desc",
        "Maximum Speed": "maximum_speed",
        "Sets the maximum client speed settings allowed while riding Happy Ghasts. Normal speed is 1.0. Overrides any client config that exeeds this.": "maximum_speed.desc",
        "OFF": "off",
        "Overridden": "overridden",
